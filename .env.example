# Database
# Option A: Docker Compose (docker compose up -d)
#   DATABASE_URL=postgresql://cadence:cadence_dev@localhost:5432/cadence
# Option B: Managed PostgreSQL (Neon, Supabase, Railway, etc.)
#   DATABASE_URL=postgresql://user:password@host:5432/cadence?sslmode=require
DATABASE_URL=postgresql://cadence:cadence_dev@localhost:5432/cadence

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production

# Node environment
NODE_ENV=development

# Zendesk
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_KEY=your-api-key

# Assembled
ASSEMBLED_API_KEY=your-api-key

# Microsoft Graph app-only access (client-credentials flow, org sync)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Microsoft Entra ID interactive sign-in (SSO). Requires its own app
# registration (or the existing one reconfigured) with:
#   - Redirect URI: https://<your-deployed-domain>/api/auth/callback/microsoft-entra-id
#   - Delegated scopes: openid, profile, email, User.Read
AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
